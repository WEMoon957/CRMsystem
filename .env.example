# =========================================================
# Docker Compose 环境变量示例：复制为 .env 后填写真实值（.env 已在 .gitignore，切勿提交）
# =========================================================

# MySQL root 密码（必填）
MYSQL_PASSWORD=change_me_to_a_strong_password

# JWT 签名密钥（必填，至少 32 字节随机串；生成：openssl rand -hex 32）
JWT_SECRET=please-generate-a-random-32-byte-secret

# 对外访问端口（前端 nginx）
WEB_PORT=80

# CORS 放行的前端来源（前后端同域部署时保持默认即可）
FRONTEND_ORIGIN=http://localhost

# 首次启动置 true 以创建主账号（仅空库生效），创建后务必改回 false 并重启
SEED_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
