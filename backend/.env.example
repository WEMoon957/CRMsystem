# 后端环境变量示例（独立运行后端时使用；Docker 部署请使用仓库根目录的 .env.example）
# 生产部署时 SPRING_PROFILES_ACTIVE=prod，且 MYSQL_URL/MYSQL_USER/MYSQL_PASSWORD/JWT_SECRET 为必填（无默认值，缺失即启动失败）

SPRING_PROFILES_ACTIVE=prod
MYSQL_URL=jdbc:mysql://localhost:3306/crm_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# JWT 签名密钥：至少 32 字节随机串（生成：openssl rand -hex 32）
JWT_SECRET=please-generate-a-random-32-byte-secret

# 前端来源（CORS）
FRONTEND_ORIGIN=http://localhost:5173

# 上传文件目录（默认 ./uploads，容器内建议 /data/uploads 并挂卷）
# UPLOAD_DIR=/data/uploads

# 首个主账号初始化：空库且 SEED_ENABLED=true 时创建一次，创建后立即改回 false
# SEED_ENABLED=false
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=Admin@123
