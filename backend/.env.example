# 后端环境变量示例（生产部署时复制为 .env 并填写真实值，切勿提交 .env）
MYSQL_URL=jdbc:mysql://localhost:33061/crm_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USER=root
MYSQL_PASSWORD=change_me
# JWT 签名密钥：生产必须替换为至少 32 字节的随机串
JWT_SECRET=please-generate-a-random-32-byte-secret
# 前端来源（CORS）
FRONTEND_ORIGIN=http://localhost:5173
